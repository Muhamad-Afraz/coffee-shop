# Firebase client config (used for Firebase, not Google login anymore)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=my-coffee-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=my-coffee-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin access (permanent). The ONLY password in the app.
# The "Visitor" role is passwordless (anyone can enter the temporary editor).
ADMIN_PASSWORD=

# Groq API key for review moderation
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# PERSISTENT STORAGE (REQUIRED for permanent admin changes on Vercel / serverless)
# ---------------------------------------------------------------------------
# Paste the FULL contents of the Firebase service-account JSON file as a single line.
# Yes, it is a large multiline JSON value - that is fine in Vercel env vars.
# Steps to get it: Firebase Console -> Project Settings -> Service accounts ->
# "Generate new private key" -> add the downloaded JSON here.
# Without this, ADMIN changes are NOT permanent across redeploys.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"my-coffee-project",...}
